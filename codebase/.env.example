# Rolling Meadows — local Docker environment
# Copy to .env and adjust for local development.
# For production see .env.production.example and deploy.sh

JWT_SECRET=dev-change-me-in-production
JWT_EXPIRES_MINUTES=480
SEED_USER_PASSWORD=ChangeMe123!

# PostgreSQL (used when running api outside compose)
DATABASE_URL=postgresql+asyncpg://rolling_meadows:rolling_meadows@localhost:5432/rolling_meadows

# FastAPI
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
DEFAULT_TENANT_ID=tenant-rolling-meadows
API_ENABLED_MODULES=health,auth,admin,platform,clients,catalog,cases,enrollments,liaison,workflow,documents,reports

# Production URL (single-port deploy uses these via docker-compose.prod.yml)
# PUBLIC_URL=https://foundry.inapp.com/rolling-meadows
# APP_BASE_PATH=/rolling-meadows

# React — local dev uses /api (vite + Docker nginx proxy)
VITE_API_BASE_URL=/api
VITE_BASE_PATH=
# Set to true only for offline demo without the API (role picker). Default: real email/password login.
VITE_USE_MOCK_AUTH=false
