# Case Management Platform — PM2 production (bare metal, no Docker)
# Copy to deploy/.env and set secrets before go-live.

APP_PORT=4510
HOST=127.0.0.1
APP_BASE_PATH=/case-management
NODE_ENV=production
TRUST_PROXY=1

# Public hostname — leave empty for loopback-only first boot (http://127.0.0.1:4510/...).
# Set PUBLIC_HOST + SSL_* below, then re-run start.sh to configure nginx.
PUBLIC_HOST=
PUBLIC_SCHEME=https
PUBLIC_URL=

# CORS (browser origin); set when using a public hostname
CORS_ORIGINS=http://127.0.0.1:4510

# PostgreSQL — local (auto-provisioned by deploy/setup-postgres.sh on start)
# SETUP_POSTGRES=0 only for remote databases
POSTGRES_USER=case_management
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=case_management
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://case_management:change-me-postgres-password@127.0.0.1:5432/case_management

# Auth — CHANGE before go-live (openssl rand -hex 32)
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_MINUTES=30
# false for loopback PM2 health checks; set true when nginx terminates TLS (uses X-Forwarded-Proto)
ENFORCE_HTTPS=false
SEED_USER_PASSWORD=ChangeMe123!
DEFAULT_TENANT_ID=tenant-demo

API_ENABLED_MODULES=health,auth,admin,platform,clients,catalog,cases,enrollments,liaison,workflow,documents,reports

# React build (used by run-production.sh)
VITE_API_BASE_URL=/case-management/api
VITE_BASE_PATH=/case-management
VITE_USE_MOCK_AUTH=false

# Optional nginx (configure-nginx.sh)
SSL_CERTIFICATE=/etc/ssl/certs/your-host.pem
SSL_CERTIFICATE_KEY=/etc/ssl/private/your-host.key
